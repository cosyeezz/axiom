{
  "name": "@cosyeezz/axiom",
  "version": "0.1.7",
  "description": "多智能体协作的可靠基础：基于 Pi SDK 的网页 Agent 工作台",
  "license": "MIT",
  "author": "cosyeezz",
  "type": "module",
  "main": "desktop/main.mjs",
  "build": {
    "appId": "com.cosyeezz.axiom",
    "productName": "Axiom",
    "asar": true,
    "npmRebuild": false,
    "files": ["desktop/*.mjs", "package.json", "!node_modules/**/*"],
    "extraResources": [{ "from": ".desktop-stage", "to": "." }],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true },
    "mac": { "target": "dmg", "category": "public.app-category.developer-tools" }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosyeezz/axiom.git"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "bin": {
    "axiom": "scripts/service.mjs",
    "axiom-setup": "scripts/install.mjs"
  },
  "files": [
    "src",
    "public",
    "scripts",
    "tests",
    "package-lock.json",
    "README.md",
    "LICENSE",
    "install.sh",
    "install.ps1",
    "install.cmd"
  ],
  "scripts": {
    "desktop:stage": "node scripts/stage-desktop.mjs",
    "desktop:dev": "electron .",
    "desktop:pack": "electron-builder --dir",
    "desktop:build": "electron-builder",
    "start": "node scripts/service.mjs",
    "dev": "node scripts/dev.mjs",
    "autostart:enable": "node scripts/autostart.mjs enable",
    "autostart:disable": "node scripts/autostart.mjs disable",
    "test": "node --test --test-timeout=120000 tests/*.test.js",
    "check": "npm test"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "dompurify": "^3.4.15",
    "jiti": "^2.7.0",
    "marked": "^18.0.12",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "jsdom": "^30.0.1"
  }
}
