{
  "name": "@myworkbench/axiom",
  "version": "0.1.2",
  "description": "多智能体协作的可靠基础：基于 Pi SDK 的网页 Agent 工作台",
  "license": "MIT",
  "author": "cosyeezz",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosyeezz/axiom.git"
  },
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "axiom": "scripts/service.mjs",
    "axiom-setup": "scripts/install.mjs"
  },
  "files": [
    "src",
    "public",
    "scripts",
    "tests",
    "package-lock.json",
    "README.md",
    "LICENSE",
    "install.sh",
    "install.ps1",
    "install.cmd"
  ],
  "scripts": {
    "start": "node scripts/service.mjs",
    "autostart:enable": "node scripts/autostart.mjs enable",
    "autostart:disable": "node scripts/autostart.mjs disable",
    "test": "node --test tests/*.test.js",
    "check": "npm test"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "dompurify": "^3.4.15",
    "jiti": "^2.7.0",
    "marked": "^18.0.12",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "jsdom": "^30.0.1"
  }
}
